<?xml version="1.0" encoding="utf-8"?>
<!-- One leader's "Today" card: company tag, leader, next three meetings (titles only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:background="@drawable/office_card_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/cardAccent"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:background="@color/marvice_accent_2" />

        <ImageView
            android:id="@+id/cardLogo"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/cardCompany"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/office_text_2"
            android:textSize="16sp"
            android:fontFamily="@font/inter_medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/cardLeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:textColor="@color/office_text"
        android:textSize="18sp"
        android:fontFamily="@font/inter_medium" />

    <LinearLayout
        android:id="@+id/cardMeetings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />
</LinearLayout>
