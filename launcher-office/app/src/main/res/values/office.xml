<?xml version="1.0" encoding="utf-8"?>
<!-- Office build defaults (batch 1). theme/config.json overrides these in a later batch. -->
<resources>
    <!-- Boardroom-calm palette (spec "Design"). -->
    <color name="office_bg">#FF0B0D0C</color>
    <color name="office_surface">#FF151917</color>
    <color name="office_surface_hi">#FF1C211F</color>
    <color name="office_text">#FFF2F1EC</color>
    <color name="office_text_2">#FF9AA39E</color>
    <color name="office_stroke">#1FF2F1EC</color>
    <color name="status_on_track">#FF3FB57A</color>
    <color name="status_at_risk">#FFE0A33A</color>
    <color name="status_off_track">#FFE05A4F</color>

    <!-- Company accents: only on focus and on that company's own cards, never as large fills. -->
    <color name="marvice_accent">#FF1F4D3A</color>
    <color name="marvice_accent_2">#FFB08D57</color>
    <color name="infyst_accent">#FF68C038</color>
    <color name="infyst_accent_2">#FF283030</color>

    <string name="company_marvice" translatable="false">Marvice Media Private Limited</string>
    <string name="company_infyst" translatable="false">Infyst Global Private Limited</string>
    <string name="company_marvice_short" translatable="false">Marvice Media</string>
    <string name="company_infyst_short" translatable="false">Infyst Global</string>
    <string name="company_both" translatable="false">Both companies</string>
    <string name="leader_marvice" translatable="false">Yuvaraj GS</string>
    <string name="leader_infyst" translatable="false">Vishal</string>

    <string name="office_dashboard" translatable="false">Dashboard</string>
    <string name="office_present" translatable="false">Present</string>
    <string name="office_meetings" translatable="false">Meetings</string>
    <string name="office_alerts" translatable="false">Alerts</string>
    <string name="office_today" translatable="false">Today</string>
    <string name="office_sample" translatable="false">Sample data</string>
    <string name="office_placeholder" translatable="false">%1$s arrives in a later batch. Press Back to return.</string>
    <string name="office_next_in" translatable="false">in %1$s</string>
    <string name="office_now" translatable="false">Now</string>
    <string name="office_weather_none" translatable="false">Weather</string>

    <!-- Office: the Wi-Fi pill shows the network name only. The Tailscale VPN is maintenance plumbing,
         not something the room needs to see, and its badge squeezed the name out of the pill. -->
    <bool name="office_vpn_badge">false</bool>
    <!-- Office: the Wi-Fi pill shows only the network name's first word ("Airtel_Infyst Global" shows "Airtel"). -->
    <bool name="office_wifi_first_word">true</bool>

    <!-- Clocks: main clock is the TV's zone (Asia/Kolkata); the world clock below it. -->
    <string name="office_city" translatable="false">Bengaluru</string>
    <string name="world_city" translatable="false">London</string>
    <string name="world_zone" translatable="false">Europe/London</string>
    <!-- Open-Meteo, no key. Bengaluru. -->
    <string name="weather_lat" translatable="false">12.97</string>
    <string name="weather_lon" translatable="false">77.59</string>

    <!-- Meeting room (spec screen 4). The laptop is on HDMI 1 (HDMIInputService/HW5 on this TV). -->
    <string name="room_laptop_input" translatable="false">com.mediatek.tvinput/.hdmi.HDMIInputService/HW5</string>
    <string name="room_cast_name_fallback" translatable="false">Office</string>
    <!-- The name Windows shows under Win + K; filled in after the test with a real laptop. -->
    <string name="room_miracast_name" translatable="false">Haier MatrixTV BE</string>
    <string name="room_hub_sub" translatable="false">Meeting room</string>
    <string name="room_no_cable" translatable="false">Mirror a laptop wirelessly, or use a cable on HDMI 1.</string>
    <string name="room_free_until" translatable="false">Free until %1$s</string>
    <string name="room_in_use_until" translatable="false">In use until %1$s</string>
    <string name="room_free_today" translatable="false">Free for the rest of the day</string>
    <string name="room_mirror" translatable="false">Mirror laptop</string>
    <string name="room_mirror_sub" translatable="false">Windows, Mac, iPhone, cable</string>
    <string name="room_mirror_status_waiting" translatable="false">Waiting for a laptop</string>
    <string name="room_way_cable" translatable="false">Cable</string>
    <string name="room_way_cable_steps" translatable="false">HDMI cable into the TV\'s HDMI 1, then press Present. Best for video and anything sensitive.</string>
    <string name="room_way_cable_lag" translatable="false">Lag: none (direct picture). Tested with a Windows laptop.</string>
    <string name="room_way_windows" translatable="false">Windows</string>
    <string name="room_way_windows_steps" translatable="false">Press OK here to open HaiCast, then on the laptop press Win + K and pick \"%1$s\". Laptop on the office Wi-Fi.</string>
    <string name="room_way_windows_lag" translatable="false">Tested with a Windows laptop: works while HaiCast is open.</string>
    <string name="room_way_chrome" translatable="false">Chrome</string>
    <string name="room_way_chrome_steps" translatable="false">Chrome menu, Cast, save and share, Cast. Choose Cast screen or Cast tab, then \"%1$s\". Laptop on the same Wi-Fi.</string>
    <string name="room_way_chrome_lag" translatable="false">Lag: about 1 second. Tested on Windows and Mac. Fine for slides, not for video calls.</string>
    <string name="room_mirror_foot" translatable="false">Android phones: Cast or Screen cast to \"Office\".</string>
    <string name="room_way_airplay" translatable="false">Apple</string>
    <string name="room_way_airplay_steps" translatable="false">iPhone, iPad or Mac: Control Center, Screen Mirroring, then \"%1$s\". Same Wi-Fi as the TV, VPN off.</string>
    <string name="room_way_airplay_lag" translatable="false">Lag: about 1 second. Tested with an iPhone; Mac AirPlay not yet tried (Mac works through Chrome).</string>
    <string name="room_cast" translatable="false">Cast</string>
    <string name="room_cast_how" translatable="false">From a phone or laptop on the office Wi-Fi: press Cast in YouTube, Meet or Chrome and pick this name.</string>
    <string name="room_cast_note" translatable="false">Casting plays on the TV; your device becomes the remote.</string>
    <string name="room_timer" translatable="false">Timer</string>
    <string name="room_timer_sub" translatable="false">Meeting countdown</string>
    <string name="room_timer_ends" translatable="false">Ends at %1$s</string>
    <string name="room_timer_five" translatable="false">5 minutes left</string>
    <string name="room_timer_over" translatable="false">Time is up</string>
    <string name="room_timer_pick" translatable="false">No meeting now. Pick a timer below.</string>
    <string name="room_standup" translatable="false">Stand-up</string>
    <string name="room_standup_sub" translatable="false">10 minutes, equal turns</string>
    <string name="room_standup_line" translatable="false">This turn %1$s  ·  Stand-up %2$s left  ·  Next: %3$s</string>
    <string name="room_standup_last" translatable="false">wrap-up</string>
    <string name="room_standup_hint" translatable="false">Press Right for the next speaker</string>
    <string name="room_standup_done" translatable="false">Due today</string>
    <string name="room_standup_done_hint" translatable="false">Stand-up done. Press Back to return.</string>
    <string name="room_laptop" translatable="false">Laptop cable</string>
    <string name="room_laptop_connected" translatable="false">HDMI 1: connected, press to show</string>
    <string name="room_laptop_empty" translatable="false">HDMI 1 empty</string>
    <!-- This TV reports every HDMI port as connected, so the card cannot say whether a cable is in. -->
    <string name="room_laptop_unknown" translatable="false">Switch to HDMI 1</string>

    <integer name="standup_minutes">10</integer>
    <!-- Sample data until the team sheet and calendars connect. -->
    <string-array name="standup_team" translatable="false">
        <item>Design</item>
        <item>Development</item>
        <item>Marketing</item>
        <item>Operations</item>
    </string-array>
    <string-array name="sample_due_today" translatable="false">
        <item>Design: festive campaign creatives</item>
        <item>Development: Hourhand release check</item>
        <item>Marketing: weekly ads report</item>
    </string-array>
    <!-- Boardroom bookings today, "HH:mm|minutes|title". -->
    <string-array name="sample_room_bookings" translatable="false">
        <item>10:30|45|IB partner call</item>
        <item>15:00|60|Client review: Q4 campaign</item>
        <item>17:30|30|Design stand-up</item>
        <item>18:00|60|Board review</item>
    </string-array>

    <!-- Sample meetings for this batch only: "HH:mm|minutes|title". Titles only, never attendees. -->
    <string-array name="sample_meetings_marvice" translatable="false">
        <item>11:00|30|Weekly ops review</item>
        <item>15:00|60|Client review: Q4 campaign</item>
        <item>17:30|30|Design stand-up</item>
    </string-array>
    <string-array name="sample_meetings_infyst" translatable="false">
        <item>10:30|45|IB partner call</item>
        <item>14:00|30|Platform release check</item>
        <item>16:30|60|KYC vendor review</item>
    </string-array>
</resources>
